# Пароли боевого сервера. Скопируйте в .env и заполните своими.
#
#   cp .env.example .env
#
# Файл .env в репозиторий не попадает (он в .gitignore). Пароли длинные
# и случайные: сгенерировать можно так —
#   openssl rand -base64 32

# База данных.
DB_PASSWORD=

# Redis.
REDIS_PASSWORD=

# Внутренний секрет Serverpod (связь между ролями сервера).
SERVICE_SECRET=

# Sentry: оставьте пустым, пока не поднят — ошибки пойдут в логи.
SENTRY_DSN=

# Пароль шифрования бэкапов. Хранить ОТДЕЛЬНО от самих бэкапов:
# потерянный пароль = потерянные бэкапы (docs/backup.md).
BACKUP_PASSWORD=
